generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// RBAC - ROLE-BASED ACCESS CONTROL
// ═══════════════════════════════════════════════════════════════

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique @db.VarChar(50)
  description String?          @db.Text
  level       Int              @default(0)
  is_system   Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique @db.VarChar(100)
  resource    String           @db.VarChar(50)
  action      String           @db.VarChar(50)
  scope       String           @default("all") @db.VarChar(20)
  description String?          @db.Text
  roles       RolePermission[]
  created_at  DateTime         @default(now())

  @@unique([resource, action, scope])
  @@map("permissions")
}

model RolePermission {
  id            Int        @id @default(autoincrement())
  role_id       Int
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission_id Int
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  created_at    DateTime   @default(now())

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

// ═══════════════════════════════════════════════════════════════
// AUTHENTICATION (NextAuth.js)
// ═══════════════════════════════════════════════════════════════

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique @db.VarChar(255)
  email_verified DateTime?
  password_hash  String?   @db.VarChar(255)
  name           String?   @db.VarChar(255)
  image          String?   @db.Text
  phone          String?   @db.VarChar(50)
  bio            String?   @db.Text
  role_id        Int       @default(1)
  role           Role      @relation(fields: [role_id], references: [id])
  is_active      Boolean   @default(true)
  last_login     DateTime?

  // SELLER STATUS
  is_seller       Boolean   @default(false)
  seller_since    DateTime?
  seller_verified Boolean   @default(false)

  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // Auth.js
  accounts     Account[]
  sessions     Session[]

  // User interactions
  favorites      Favorite[]
  appointments   Appointment[] @relation("UserAppointments")
  inquiries      Inquiry[]     @relation("UserInquiries")
  notifications  Notification[]
  audit_logs     AuditLog[]
  property_views PropertyView[]

  // Agent relations
  agent_assignments   PropertyAgent[] @relation("AgentAssignments")
  assigned_by_records PropertyAgent[] @relation("AssignedBy")
  primary_properties  Property[]      @relation("PrimaryAgent")
  agent_appointments  Appointment[]   @relation("AgentAppointments")
  agent_inquiries     Inquiry[]       @relation("AgentInquiries")

  // SELLER relations
  listed_properties   Property[] @relation("ListedBy")
  reviewed_properties Property[] @relation("ReviewedBy")

  @@index([email])
  @@index([role_id])
  @@index([is_seller])
  @@map("users")
}

model Account {
  id                  String  @id @default(cuid())
  user_id             Int
  user                User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type                String  @db.VarChar(50)
  provider            String  @db.VarChar(50)
  provider_account_id String  @db.VarChar(255)
  refresh_token       String? @db.Text
  access_token        String? @db.Text
  expires_at          Int?
  token_type          String? @db.VarChar(50)
  scope               String? @db.Text
  id_token            String? @db.Text
  session_state       String? @db.Text

  @@unique([provider, provider_account_id])
  @@map("accounts")
}

model Session {
  id            String   @id @default(cuid())
  session_token String   @unique @db.VarChar(255)
  user_id       Int
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires       DateTime
  created_at    DateTime @default(now())

  @@map("sessions")
}

model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ═══════════════════════════════════════════════════════════════
// PROPERTIES (Metadata - Content vjen nga Sanity)
// ═══════════════════════════════════════════════════════════════

model Property {
  id             Int       @id @default(autoincrement())
  sanity_id      String    @unique @db.VarChar(100)
  slug           String    @unique @db.VarChar(200)
  title          String    @db.VarChar(500)
  price          Decimal   @db.Decimal(12, 2)
  price_per_m2   Decimal?  @db.Decimal(10, 2)
  status         String    @default("PUBLISHED") @db.VarChar(20)
  featured       Boolean   @default(false)
  listing_type   String    @default("sale") @db.VarChar(20)

  // ═══════════════════════════════════════════════════════════
  // SEARCH & OPTIMIZATION (NLP + FTS)
  // ═══════════════════════════════════════════════════════════
  // search_vector: tsvector (Unsupported në Prisma)
  // primary_image_url: URL e fotos kryesore nga Sanity (për listing performance)
  primary_image_url String? @db.Text

  // ═══════════════════════════════════════════════════════════
  // LOKACIONI
  // ═══════════════════════════════════════════════════════════
  location              String?  @db.VarChar(500)
  neighborhood          String?  @db.VarChar(100)
  city                  String?  @db.VarChar(100)
  postal_code           String?  @db.VarChar(20)
  latitude              Decimal? @db.Decimal(10, 8)
  longitude             Decimal? @db.Decimal(11, 8)
  distance_from_center  Decimal? @db.Decimal(10, 2)

  // ═══════════════════════════════════════════════════════════
  // KARAKTERISTIKAT E PRONËS
  // ═══════════════════════════════════════════════════════════
  property_type    String?  @db.VarChar(50)
  bedrooms         Int?
  bathrooms        Int?
  area             Int?
  balconies        Int      @default(0)
  floor            Int?
  total_floors     Int?
  year_built       Int?
  renovation_year  Int?
  condition        String?  @db.VarChar(30)
  orientation      String?  @db.VarChar(30)
  furnished        String?  @db.VarChar(30)

  // ═══════════════════════════════════════════════════════════
  // VEÇORITË (BOOLEAN)
  // ═══════════════════════════════════════════════════════════
  has_elevator         Boolean @default(false)
  has_parking          Boolean @default(false)
  has_garden           Boolean @default(false)
  has_pool             Boolean @default(false)
  has_air_conditioning Boolean @default(false)
  has_heating          Boolean @default(false)
  has_security         Boolean @default(false)
  has_internet         Boolean @default(false)

  // ═══════════════════════════════════════════════════════════
  // VEÇORI TË TJERA
  // ═══════════════════════════════════════════════════════════
  features      String[] @default([])
  energy_class  String?  @db.VarChar(10)

  // ═══════════════════════════════════════════════════════════
  // SOURCE DHE REVIEW
  // ═══════════════════════════════════════════════════════════
  source        String  @default("OWNER") @db.VarChar(20)
  review_status String  @default("APPROVED") @db.VarChar(20)

  listed_by_id Int?
  listed_by    User? @relation("ListedBy", fields: [listed_by_id], references: [id], onDelete: SetNull)

  reviewed_by_id Int?
  reviewed_by    User? @relation("ReviewedBy", fields: [reviewed_by_id], references: [id], onDelete: SetNull)

  reviewed_at      DateTime?
  rejection_reason String?   @db.Text

  // ═══════════════════════════════════════════════════════════
  // AGENT
  // ═══════════════════════════════════════════════════════════
  primary_agent_id Int?
  primary_agent    User?             @relation("PrimaryAgent", fields: [primary_agent_id], references: [id])
  agents           PropertyAgent[]

  // ═══════════════════════════════════════════════════════════
  // ANALYTICS
  // ═══════════════════════════════════════════════════════════
  view_count        Int @default(0)
  favorite_count    Int @default(0)
  appointment_count Int @default(0)
  inquiry_count     Int @default(0)

  // ═══════════════════════════════════════════════════════════
  // TIMESTAMPS
  // ═══════════════════════════════════════════════════════════
  published_at DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // ═══════════════════════════════════════════════════════════
  // RELATIONS
  // ═══════════════════════════════════════════════════════════
  favorites    Favorite[]
  appointments Appointment[]
  inquiries    Inquiry[]
  views        PropertyView[]

  // ═══════════════════════════════════════════════════════════
  // INDEXES
  // ═══════════════════════════════════════════════════════════
  // Bazë
  @@index([price])
  @@index([city])
  @@index([neighborhood])
  @@index([status])
  @@index([featured])
  @@index([source])
  @@index([review_status])
  @@index([listed_by_id])
  @@index([property_type])
  @@index([listing_type])
  @@index([bedrooms])
  @@index([area])
  
  // Composite për filtra
  @@index([status, price])
  @@index([status, city])
  @@index([status, bedrooms])
  @@index([status, listing_type])
  @@index([status, property_type])
  @@index([review_status, status])
  
  @@map("properties")
}

model PropertyView {
  id          Int      @id @default(autoincrement())
  property_id Int
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  user_id     Int?
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  ip_address  String?  @db.VarChar(45)
  user_agent  String?  @db.Text
  viewed_at   DateTime @default(now())

  @@index([property_id])
  @@index([user_id])
  @@map("property_views")
}

// ═══════════════════════════════════════════════════════════════
// AGENT ASSIGNMENTS
// ═══════════════════════════════════════════════════════════════

model PropertyAgent {
  id          Int      @id @default(autoincrement())
  property_id Int
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  agent_id    Int
  agent       User     @relation("AgentAssignments", fields: [agent_id], references: [id], onDelete: Cascade)
  assigned_by Int
  assigner    User     @relation("AssignedBy", fields: [assigned_by], references: [id])

  is_primary Boolean @default(true)
  notes      String? @db.Text
  status     String  @default("ACTIVE") @db.VarChar(20)

  assigned_at DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([property_id, agent_id])
  @@index([property_id])
  @@index([agent_id])
  @@index([status])
  @@map("property_agents")
}

// ═══════════════════════════════════════════════════════════════
// USER INTERACTIONS
// ═══════════════════════════════════════════════════════════════

model Favorite {
  id          Int      @id @default(autoincrement())
  user_id     Int
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  property_id Int
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())

  @@unique([user_id, property_id])
  @@index([user_id])
  @@index([property_id])
  @@map("favorites")
}

model Appointment {
  id          Int      @id @default(autoincrement())
  user_id     Int
  user        User     @relation("UserAppointments", fields: [user_id], references: [id], onDelete: Cascade)
  property_id Int
  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  agent_id Int?
  agent    User? @relation("AgentAppointments", fields: [agent_id], references: [id])

  scheduled_at DateTime
  status       String    @default("PENDING") @db.VarChar(20)
  notes        String?   @db.Text
  owner_notes  String?   @db.Text
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([user_id])
  @@index([property_id])
  @@index([agent_id])
  @@index([scheduled_at])
  @@index([status])
  @@map("appointments")
}

model Inquiry {
  id          Int       @id @default(autoincrement())
  user_id     Int?
  user        User?     @relation("UserInquiries", fields: [user_id], references: [id], onDelete: SetNull)
  property_id Int?
  property    Property? @relation(fields: [property_id], references: [id], onDelete: SetNull)

  agent_id Int?
  agent    User? @relation("AgentInquiries", fields: [agent_id], references: [id])

  name         String    @db.VarChar(255)
  email        String    @db.VarChar(255)
  phone        String?   @db.VarChar(50)
  message      String    @db.Text
  status       String    @default("NEW") @db.VarChar(20)
  responded_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  @@index([user_id])
  @@index([property_id])
  @@index([agent_id])
  @@index([status])
  @@map("inquiries")
}

model Notification {
  id         Int       @id @default(autoincrement())
  user_id    Int
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(255)
  message    String    @db.Text
  link       String?   @db.VarChar(500)
  is_read    Boolean   @default(false)
  read_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
  @@index([is_read])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════
// SYSTEM
// ═══════════════════════════════════════════════════════════════

model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  action      String   @db.VarChar(100)
  resource    String   @db.VarChar(50)
  resource_id String?  @db.VarChar(100)
  old_values  Json?
  new_values  Json?
  ip_address  String?  @db.VarChar(45)
  user_agent  String?  @db.Text
  created_at  DateTime @default(now())

  @@index([user_id])
  @@index([resource])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("settings")
}